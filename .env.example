# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# --- Auth / JWT ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_db

# --- Redis cache (optional; the app fails open if Redis is unreachable) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Email (SMTP for background notifications) ---
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Local demo seed (used by seed_demo_user.py) ---
SEED_MANAGER_EMAIL=manager@demo.com
SEED_MANAGER_PASSWORD=change-me
